{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "institution_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "notice_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "notice_year": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "selection_type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "GRADUATE_ENTRY",
            "TRANSFER",
            "COURSE_CHANGE",
            "SPECIFIC_KNOWLEDGE",
            "REMAINING_SEATS",
            "FIELD_EDUCATION",
            "ENEM_OWN_SELECTION",
            "SCHOOL_RECORD",
            "OLYMPIAD_ENTRY",
            "PRONERA_GRADUATION",
            "SISU",
            "SISU_PLUS"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "regular_sisu_flow": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "requires_enem": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "tuition_free": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "application_fee_brl": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "application_windows": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "start_time": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "end_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "end_time": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timezone": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "label",
              "start_date",
              "start_time",
              "end_date",
              "end_time",
              "timezone"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "offerings": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "course": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "degree_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "campus": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "modality": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "shift": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "seats": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reservations": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "category": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "seats": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "requirements": {
                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "criterion": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "required": {
                                    "type": [
                                      "boolean",
                                      "null"
                                    ]
                                  },
                                  "value": {
                                    "anyOf": [
                                      {
                                        "$ref": "#/$defs/__schema0"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "criterion",
                                  "required",
                                  "value"
                                ],
                                "additionalProperties": false
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "category",
                        "seats",
                        "requirements"
                      ],
                      "additionalProperties": false
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "requirements": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "criterion": {
                          "type": "string",
                          "minLength": 1
                        },
                        "required": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "value": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/__schema0"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "criterion",
                        "required",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "course",
              "degree_type",
              "campus",
              "modality",
              "shift",
              "seats",
              "reservations",
              "requirements"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "requirements": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/__schema0"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "criterion",
              "required",
              "value"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "page_or_section": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "document_id",
          "page_or_section",
          "excerpt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "institution_id",
    "notice_number",
    "notice_year",
    "selection_type",
    "regular_sisu_flow",
    "requires_enem",
    "tuition_free",
    "application_fee_brl",
    "application_windows",
    "offerings",
    "requirements",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
