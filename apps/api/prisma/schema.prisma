generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Jurisdiction {
  FEDERAL
  ESTADUAL
}

enum SourceKind {
  HTML_INDEX
  SITEMAP
  RSS
}

enum DocumentRelationType {
  ATTACHMENT
  TIMELINE
  RECTIFICATION
  RELATED
}

enum DocumentParserKind {
  HTML_DOCUMENT
  PDF_TEXT
  OCR
}

enum SourceStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum SourceHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  BLOCKED
}

enum CrawlRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum CrawlErrorCode {
  NETWORK
  TIMEOUT
  RATE_LIMITED
  HTTP_4XX
  HTTP_5XX
  ACCESS_DENIED
  PARSE_ERROR
  UNKNOWN
}

enum DiscoveredUrlStatus {
  CANDIDATE
  FETCHED
  REJECTED
  QUARANTINED
}

enum PublicationStatus {
  RASCUNHO
  EM_REVISAO
  PUBLICADO
  OCULTO
  ARQUIVADO
}

enum ProcessIngestionState {
  CANDIDATE
  FETCHED
  CLASSIFIED
  EXTRACTED
  NEEDS_REVIEW
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum AdminRole {
  ADMIN
  CURATOR
}

model Institution {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(250)
  normalizedName String       @unique @map("normalized_name") @db.VarChar(250)
  acronym        String       @unique @db.VarChar(16)
  jurisdiction   Jurisdiction
  publicFlag     Boolean      @default(true) @map("public_flag")
  verifiedAt     DateTime?    @map("verified_at") @db.Timestamptz(6)
  referenceUrl   String?      @map("reference_url") @db.Text
  campuses       Campus[]
  allowedDomains AllowedDomain[]
  sources        Source[]
  processes      SelectionProcess[]

  @@map("institutions")
}

model Campus {
  id             String      @id @default(uuid()) @db.Uuid
  institutionId  String      @map("institution_id") @db.Uuid
  name           String      @db.VarChar(200)
  normalizedName String      @map("normalized_name") @db.VarChar(200)
  city           String      @db.VarChar(150)
  normalizedCity String      @map("normalized_city") @db.VarChar(150)
  state          String      @db.Char(2)
  timezone       String      @db.VarChar(64)
  verifiedAt     DateTime?   @map("verified_at") @db.Timestamptz(6)
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  offerings      Offering[]

  @@unique([id, institutionId], map: "campuses_id_institution_key")
  @@unique([institutionId, normalizedName, normalizedCity], map: "campuses_institution_name_city_key")
  @@index([state, normalizedCity], map: "campuses_state_city_idx")
  @@index([institutionId, verifiedAt], map: "campuses_institution_verified_idx")
  @@map("campuses")
}

model AllowedDomain {
  id                String       @id @default(uuid()) @db.Uuid
  institutionId     String       @map("institution_id") @db.Uuid
  host              String       @db.VarChar(253)
  evidenceUrl       String       @map("evidence_url") @db.Text
  reviewedAt        DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  collectionAllowed Boolean      @default(false) @map("collection_allowed")
  institution       Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  sources           Source[]

  @@unique([institutionId, host], map: "allowed_domains_institution_host_key")
  @@unique([id, institutionId], map: "allowed_domains_id_institution_key")
  @@map("allowed_domains")
}

model Source {
  id               String        @id @default(uuid()) @db.Uuid
  institutionId    String        @map("institution_id") @db.Uuid
  allowedDomainId  String        @map("allowed_domain_id") @db.Uuid
  url              String        @db.Text
  kind             SourceKind
  selector         String?       @db.Text
  frequencyMinutes Int           @default(1440) @map("frequency_minutes")
  priority         Int           @default(100)
  status           SourceStatus  @default(DRAFT)
  health           SourceHealth  @default(UNKNOWN)
  lastCheckedAt    DateTime?     @map("last_checked_at") @db.Timestamptz(6)
  lastSuccessAt    DateTime?     @map("last_success_at") @db.Timestamptz(6)
  etag             String?       @db.VarChar(512)
  lastModified     String?       @map("last_modified") @db.VarChar(128)
  discoveryCursor  Json?         @map("discovery_cursor") @db.JsonB
  strategyLastExecutedAt DateTime? @map("strategy_last_executed_at") @db.Timestamptz(6)
  snapshotRetentionDays Int?      @map("snapshot_retention_days")
  retentionReviewedAt DateTime? @map("retention_reviewed_at") @db.Timestamptz(6)
  institution      Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  allowedDomain    AllowedDomain @relation(fields: [allowedDomainId, institutionId], references: [id, institutionId], onDelete: Restrict)
  crawlRuns        CrawlRun[]
  observations     DiscoveryObservation[]

  @@unique([institutionId, url], map: "sources_institution_url_key")
  @@index([status, priority], map: "sources_status_priority_idx")
  @@map("sources")
}

model CrawlRun {
  id           String                 @id @default(uuid()) @db.Uuid
  sourceId     String                 @map("source_id") @db.Uuid
  startedAt    DateTime               @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?              @map("finished_at") @db.Timestamptz(6)
  attempt      Int                    @default(1)
  status       CrawlRunStatus         @default(RUNNING)
  httpStatus   Int?                   @map("http_status")
  success      Boolean?
  errorCode    CrawlErrorCode?        @map("error_code")
  source       Source                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  observations DiscoveryObservation[]

  @@unique([id, sourceId], map: "crawl_runs_id_source_key")
  @@index([sourceId, startedAt], map: "crawl_runs_source_started_idx")
  @@map("crawl_runs")
}

model DiscoveredUrl {
  id             String                 @id @default(uuid()) @db.Uuid
  canonicalUrl   String                 @unique @map("canonical_url") @db.Text
  foundAt        DateTime               @default(now()) @map("found_at") @db.Timestamptz(6)
  lastSeenAt     DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  seenCount      Int                    @default(1) @map("seen_count")
  relevanceScore Float?                 @map("relevance_score")
  status         DiscoveredUrlStatus    @default(CANDIDATE)
  observations   DiscoveryObservation[]
  documents      Document[]

  @@map("discovered_urls")
}

model DiscoveryObservation {
  id              String        @id @default(uuid()) @db.Uuid
  discoveredUrlId String        @map("discovered_url_id") @db.Uuid
  sourceId        String        @map("source_id") @db.Uuid
  crawlRunId      String        @map("crawl_run_id") @db.Uuid
  firstSeenAt     DateTime      @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt      DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  seenCount       Int           @default(1) @map("seen_count")
  discoveredUrl   DiscoveredUrl @relation(fields: [discoveredUrlId], references: [id], onDelete: Restrict)
  source          Source        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  crawlRun        CrawlRun      @relation(fields: [crawlRunId, sourceId], references: [id, sourceId], onDelete: Restrict)

  @@unique([discoveredUrlId, crawlRunId], map: "discovery_observations_url_run_key")
  @@index([sourceId, firstSeenAt], map: "discovery_observations_source_seen_idx")
  @@map("discovery_observations")
}

model DocumentBlob {
  sha256      String     @id @db.Char(64)
  storageKey  String     @map("storage_key") @db.Text
  byteLength  Int        @map("byte_length")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  expiredAt   DateTime?  @map("expired_at") @db.Timestamptz(6)
  documents   Document[]
  parserCache DocumentParseCache[]

  @@unique([sha256, storageKey], map: "document_blobs_hash_storage_key")
  @@map("document_blobs")
}

model DocumentParseCache {
  sha256        String             @db.Char(64)
  parserKind    DocumentParserKind @map("parser_kind")
  parserVersion Int                @map("parser_version")
  resultJson    Json               @map("result_json") @db.JsonB
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  blob          DocumentBlob       @relation(fields: [sha256], references: [sha256], onDelete: Restrict)

  @@id([sha256, parserKind, parserVersion], map: "document_parse_cache_pkey")
  @@index([createdAt], map: "document_parse_cache_created_idx")
  @@map("document_parse_cache")
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  discoveredUrlId String?        @map("discovered_url_id") @db.Uuid
  url             String         @db.Text
  sha256          String         @db.Char(64)
  storageKey      String         @map("storage_key") @db.Text
  mediaType       String         @map("media_type") @db.VarChar(128)
  version         Int
  capturedAt      DateTime       @default(now()) @map("captured_at") @db.Timestamptz(6)
  lastSeenAt      DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  issuedAt        DateTime?      @map("issued_at") @db.Timestamptz(6)
  blob            DocumentBlob   @relation(fields: [sha256, storageKey], references: [sha256, storageKey], onDelete: Restrict)
  discoveredUrl   DiscoveredUrl? @relation(fields: [discoveredUrlId], references: [id], onDelete: Restrict)
  evidence        Evidence[]
  revisions       Revision[]
  outgoingRelations DocumentRelation[] @relation("document_relation_origin")
  incomingRelations DocumentRelation[] @relation("document_relation_related")

  @@unique([url, version], map: "documents_url_version_key")
  @@index([sha256], map: "documents_sha256_idx")
  @@index([discoveredUrlId], map: "documents_discovered_url_idx")
  @@map("documents")
}

model DocumentRelation {
  id                String               @id @default(uuid()) @db.Uuid
  originDocumentId  String               @map("origin_document_id") @db.Uuid
  relatedDocumentId String               @map("related_document_id") @db.Uuid
  relationType      DocumentRelationType @map("relation_type")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  originDocument    Document             @relation("document_relation_origin", fields: [originDocumentId], references: [id], onDelete: Restrict)
  relatedDocument   Document             @relation("document_relation_related", fields: [relatedDocumentId], references: [id], onDelete: Restrict)

  @@unique([originDocumentId, relatedDocumentId, relationType], map: "document_relations_pair_type_key")
  @@index([originDocumentId, createdAt, id], map: "document_relations_origin_created_idx")
  @@index([relatedDocumentId, relationType, createdAt], map: "document_relations_target_type_created_idx")
  @@map("document_relations")
}

model SelectionProcess {
  id              String              @id @default(uuid()) @db.Uuid
  institutionId   String              @map("institution_id") @db.Uuid
  noticeCode      String?             @map("notice_code") @db.VarChar(100)
  noticeYear      Int?                @map("notice_year")
  selectionType   String?             @map("selection_type") @db.VarChar(64)
  regularSisuFlow Boolean?            @map("regular_sisu_flow")
  requiresEnem    Boolean?            @map("requires_enem")
  tuitionFree     Boolean?            @map("tuition_free")
  demoHistorical  Boolean             @default(false) @map("demo_historical")
  referenceUrl    String?             @map("reference_url") @db.Text
  verifiedAt      DateTime?           @map("verified_at") @db.Timestamptz(6)
  ingestionState  ProcessIngestionState @default(CANDIDATE) @map("ingestion_state")
  ingestionStateReason String?         @map("ingestion_state_reason") @db.Text
  publicationStatus PublicationStatus @default(RASCUNHO) @map("publication_status")
  reviewVersion   Int                 @default(0) @map("review_version")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  institution     Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  offerings       Offering[]
  windows         ApplicationWindow[]
  requirements    Requirement[]
  evidence        Evidence[]
  revisions       Revision[]
  reviewDecisions ReviewDecision[]

  @@unique([institutionId, noticeCode, noticeYear], map: "processes_institution_notice_year_key")
  @@unique([id, institutionId], map: "processes_id_institution_key")
  @@index([publicationStatus, institutionId], map: "processes_publication_institution_idx")
  @@index([publicationStatus, verifiedAt, id], map: "processes_publication_verified_idx")
  @@index([ingestionState, createdAt, id], map: "processes_ingestion_state_created_idx")
  @@index([selectionType, requiresEnem], map: "processes_type_enem_idx")
  @@map("selection_processes")
}

model Evidence {
  id            String           @id @default(uuid()) @db.Uuid
  processId     String           @map("process_id") @db.Uuid
  documentId    String           @map("document_id") @db.Uuid
  fieldPath     String           @map("field_path") @db.VarChar(250)
  pageOrSection String?          @map("page_or_section") @db.VarChar(150)
  quote         String           @db.Text
  checkedAt     DateTime?        @map("checked_at") @db.Timestamptz(6)
  process       SelectionProcess @relation(fields: [processId], references: [id], onDelete: Restrict)
  document      Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([processId, fieldPath], map: "evidence_process_field_idx")
  @@index([documentId], map: "evidence_document_idx")
  @@map("evidence")
}

model Revision {
  id                String           @id @default(uuid()) @db.Uuid
  processId         String           @map("process_id") @db.Uuid
  documentId        String           @map("document_id") @db.Uuid
  changedFieldsJson Json             @map("changed_fields_json")
  supersedesId      String?          @map("supersedes_id") @db.Uuid
  detectedAt        DateTime         @default(now()) @map("detected_at") @db.Timestamptz(6)
  process           SelectionProcess @relation(fields: [processId], references: [id], onDelete: Restrict)
  document          Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  supersedes        Revision?        @relation("revision_history", fields: [supersedesId, processId], references: [id, processId], onDelete: Restrict)
  supersededBy      Revision[]       @relation("revision_history")

  @@unique([id, processId], map: "revisions_id_process_key")
  @@unique([supersedesId], map: "revisions_supersedes_key")
  @@index([processId, detectedAt], map: "revisions_process_detected_idx")
  @@map("revisions")
}

model ReviewDecision {
  id         String           @id @default(uuid()) @db.Uuid
  processId  String           @map("process_id") @db.Uuid
  reviewerId String           @map("reviewer_id") @db.VarChar(128)
  decision   String           @db.VarChar(64)
  reason     String           @db.Text
  reviewedAt DateTime         @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  process    SelectionProcess @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@index([processId, reviewedAt], map: "review_decisions_process_reviewed_idx")
  @@map("review_decisions")
}

model AdminUser {
  id        String       @id @default(uuid()) @db.Uuid
  issuer    String       @db.VarChar(512)
  subject   String       @db.VarChar(255)
  role      AdminRole
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditEvents AuditEvent[]

  @@unique([issuer, subject], map: "admin_users_issuer_subject_key")
  @@index([active, role], map: "admin_users_active_role_idx")
  @@map("admin_users")
}

model AuditEvent {
  id               String    @id @default(uuid()) @db.Uuid
  actorAdminUserId String    @map("actor_admin_user_id") @db.Uuid
  actorIssuer      String    @map("actor_issuer") @db.VarChar(512)
  actorSubject     String    @map("actor_subject") @db.VarChar(255)
  action           String    @db.VarChar(100)
  resourceType     String    @map("resource_type") @db.VarChar(100)
  resourceId       String    @map("resource_id") @db.VarChar(255)
  reason           String    @db.Text
  beforeJson       Json?     @map("before_json") @db.JsonB
  afterJson        Json?     @map("after_json") @db.JsonB
  requestId        String?   @map("request_id") @db.VarChar(128)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  actor            AdminUser @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt], map: "audit_events_resource_created_idx")
  @@index([actorAdminUserId, createdAt], map: "audit_events_actor_created_idx")
  @@map("audit_events")
}

model Offering {
  id                   String                @id @default(uuid()) @db.Uuid
  processId            String                @map("process_id") @db.Uuid
  institutionId        String                @map("institution_id") @db.Uuid
  campusId             String?               @map("campus_id") @db.Uuid
  courseName           String                @map("course_name") @db.VarChar(250)
  normalizedCourseName String                @map("normalized_course_name") @db.VarChar(250)
  degreeType           String?               @map("degree_type") @db.VarChar(32)
  modality             String?               @db.VarChar(64)
  shift                String?               @db.VarChar(64)
  seats                Int?
  process              SelectionProcess      @relation(fields: [processId, institutionId], references: [id, institutionId], onDelete: Restrict)
  campus               Campus?               @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Restrict)
  reservations         OfferingReservation[]
  windows              ApplicationWindow[]
  requirements         Requirement[]

  @@unique([id, processId], map: "offerings_id_process_key")
  @@index([normalizedCourseName], map: "offerings_course_idx")
  @@index([campusId], map: "offerings_campus_idx")
  @@index([modality, degreeType], map: "offerings_modality_degree_idx")
  @@map("offerings")
}

model OfferingReservation {
  id                 String        @id @default(uuid()) @db.Uuid
  offeringId         String        @map("offering_id") @db.Uuid
  category           String        @db.VarChar(150)
  normalizedCategory String        @map("normalized_category") @db.VarChar(150)
  seats              Int?
  offering           Offering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  requirements       Requirement[]

  @@unique([offeringId, normalizedCategory], map: "reservations_offering_category_key")
  @@unique([id, offeringId], map: "reservations_id_offering_key")
  @@map("offering_reservations")
}

model ApplicationWindow {
  id              String            @id @default(uuid()) @db.Uuid
  processId       String            @map("process_id") @db.Uuid
  offeringId      String?           @map("offering_id") @db.Uuid
  label           String?           @db.VarChar(150)
  startDate       DateTime?         @map("start_date") @db.Date
  startTime       String?           @map("start_time") @db.VarChar(5)
  endDate         DateTime?         @map("end_date") @db.Date
  endTime         String?           @map("end_time") @db.VarChar(5)
  timezone        String?           @db.VarChar(64)
  instructionsUrl String?           @map("instructions_url") @db.Text
  process         SelectionProcess  @relation(fields: [processId], references: [id], onDelete: Restrict)
  offering        Offering?         @relation(fields: [offeringId, processId], references: [id, processId], onDelete: Restrict)

  @@index([processId, endDate], map: "windows_process_end_date_idx")
  @@index([endDate, endTime], map: "windows_end_date_time_idx")
  @@map("application_windows")
}

model Requirement {
  id            String               @id @default(uuid()) @db.Uuid
  processId     String               @map("process_id") @db.Uuid
  offeringId    String?              @map("offering_id") @db.Uuid
  reservationId String?              @map("reservation_id") @db.Uuid
  criterion     String               @db.VarChar(200)
  required      Boolean?
  valueJson     Json?                @map("value_json")
  process       SelectionProcess     @relation(fields: [processId], references: [id], onDelete: Restrict)
  offering      Offering?            @relation(fields: [offeringId, processId], references: [id, processId], onDelete: Restrict)
  reservation   OfferingReservation? @relation(fields: [reservationId, offeringId], references: [id, offeringId], onDelete: Restrict)

  @@index([processId], map: "requirements_process_idx")
  @@map("requirements")
}
